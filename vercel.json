{
  "cleanUrls": false,
  "trailingSlash": false,
  "buildCommand": "",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/schedule",
      "destination": "/pages/schedule.html"
    },
    {
      "source": "/roster",
      "destination": "/pages/roster.html"
    },
    {
      "source": "/stats",
      "destination": "/pages/stats.html"
    },
    {
      "source": "/leaderboard",
      "destination": "/pages/leaderboard.html"
    },
    {
      "source": "/news",
      "destination": "/pages/news.html"
    },
    {
      "source": "/events",
      "destination": "/pages/events.html"
    },
    {
      "source": "/gallery",
      "destination": "/pages/gallery.html"
    },
    {
      "source": "/chat",
      "destination": "/pages/chat.html"
    },
    {
      "source": "/summer-hockey",
      "destination": "/pages/summer.html"
    },
    {
      "source": "/alumni",
      "destination": "/pages/alumni.html"
    },
    {
      "source": "/sponsors",
      "destination": "/pages/sponsors.html"
    },
    {
      "source": "/tryouts",
      "destination": "/pages/tryouts.html"
    },
    {
      "source": "/contact",
      "destination": "/pages/contact.html"
    },
    {
      "source": "/profile",
      "destination": "/pages/profile.html"
    },
    {
      "source": "/rsvp",
      "destination": "/pages/rsvp.html"
    },
    {
      "source": "/gameday",
      "destination": "/pages/gameday.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/jv-roster",
      "destination": "/pages/jv-roster.html"
    },
    {
      "source": "/jv-schedule",
      "destination": "/pages/jv-schedule.html"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/admin.html",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/pages/summer.html",
      "destination": "/summer-hockey",
      "permanent": true
    },
    {
      "source": "/pages/:slug.html",
      "destination": "/:slug",
      "permanent": true
    },
    {
      "source": "/summer",
      "destination": "/summer-hockey",
      "permanent": true
    },
    {
      "source": "/pages/jv-roster.html",
      "destination": "/jv-roster",
      "permanent": true
    },
    {
      "source": "/pages/jv-schedule.html",
      "destination": "/jv-schedule",
      "permanent": true
    }
  ]
}
